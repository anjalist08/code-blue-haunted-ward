{
  "name": "code-blue-haunted-ward",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev:actors": "durable-actors dev",
    "dev:relay": "bun scripts/relay-local.ts",
    "dev": "durable-actors generate src/actors.ts && bun scripts/dev.ts",
    "server": "bun src/server/index.ts",
    "web": "vite",
    "generate": "durable-actors generate src/actors.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "durable-actors generate src/actors.ts && tsc --noEmit && vite build",
    "serve": "bun scripts/serve.ts",
    "deploy:freestyle": "bash scripts/freestyle/deploy.sh"
  },
  "dependencies": {
    "@agent-relay/sdk": "^15.0.1",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "durable-actors": "0.14.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.170.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}

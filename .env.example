# --- Terse durable actors (printed by `bun run dev:actors`) ---
DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7100
DURABLE_ACTORS_PORT=7100

# --- OpenAI: agents' brain + Realtime voice ---
OPENAI_API_KEY=sk-...
OPENAI_AGENT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=ash
VOICE_MAX_SECONDS=180
LLM_BUDGET_CALLS=1500

# --- Agent Relay ---
# Leave both empty to auto-create a hosted workspace (saved in .ward/relay.json).
# For a private local server: `bun run dev:relay`, then RELAY_BASE_URL=http://127.0.0.1:8787
RELAY_BASE_URL=
RELAY_WORKSPACE_KEY=
# RELAY_DISABLED=1   # force the in-process fallback bus

# --- App ---
PORT=3000
API_PORT=3001
# Public HTTPS URL for phones (needed for the mic on phones), e.g. from `cloudflared tunnel --url http://localhost:3000`
PUBLIC_URL=
